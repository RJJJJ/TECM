{
  "name": "admin-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:sharp": "node scripts/sharp-runtime-smoke.mjs",
    "security:image-guard": "node scripts/image-processing-guard.mjs",
    "test:e2e": "playwright test",
    "test:e2e:verify": "node scripts/verify-playwright-results.mjs",
    "test:e2e:list": "playwright test --list"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.8",
    "next": "15.5.21",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.14.10",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "autoprefixer": "^10.4.19",
    "postcss": "8.5.18",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.18"
    },
    "postcss": "$postcss",
    "sharp": "0.35.3"
  }
}
