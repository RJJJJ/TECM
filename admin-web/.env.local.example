# Public Supabase values used by the browser client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only Supabase service role key.
# Never expose this value to client components, NEXT_PUBLIC_* variables, browser bundles, logs, or screenshots.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for n8n/external automation route handlers.
# Production must use a long, random, high-entropy string and keep it server-side only.
TECM_AUTOMATION_SECRET=
TECM_AUTOMATION_ORGANIZATION_SECRETS=
TECM_ORGANIZATION_ID=10000000-0000-4000-8000-000000000000

# Optional acceptance-test account created by the local seed.
PLAYWRIGHT_ADMIN_EMAIL=admin@tecm.local
PLAYWRIGHT_ADMIN_PASSWORD=LocalDemoOnly-1234
