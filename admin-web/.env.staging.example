# TECM Admin Web staging environment example.
# Copy to .env.staging in the deployment environment only. Do not commit real values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TECM_AUTOMATION_SECRET=
NEXT_PUBLIC_APP_ENV=staging

# SUPABASE_SERVICE_ROLE_KEY is server-only. Never expose it as NEXT_PUBLIC_*.
# TECM_AUTOMATION_SECRET should be a long random value.
# Do not prefix service role or automation secret with NEXT_PUBLIC.
# Do not commit .env.staging.
