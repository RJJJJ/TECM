# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server only. Never expose this value to n8n or the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# n8n -> Admin Web automation authentication
TECM_AUTOMATION_SECRET=replace-with-at-least-32-random-characters
# Optional per-organization rotation map:
# TECM_AUTOMATION_ORGANIZATION_SECRETS={"10000000-0000-4000-8000-000000000000":"replace-me"}

TECM_ADMIN_WEB_URL=http://host.docker.internal:3000
TECM_ORGANIZATION_ID=10000000-0000-4000-8000-000000000000

PLAYWRIGHT_ADMIN_EMAIL=admin@tecm.local
PLAYWRIGHT_ADMIN_PASSWORD=LocalDemoOnly-1234
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
